#!/usr/bin/env bash
set -euo pipefail
# Resolve this checkout even when installed as a symlink.
project=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
if (($# == 0)); then
  printf '%s\n' 'Usage: eapdf-regenerate-experimental sample|everything [options]' \
    'Requires C2PA and PAdES B-LTA on every outer output PDF.' \
    'Uses config/signing-digicert.local.json and its current security-file paths.' \
    'Both modes CLEAR the project out/ directory when run.' \
    'sample: two small inputs per type; everything: every eligible supported input file.' \
    'PST/MBOX: whole-source 1m, 1mi, 1c and 1ci archives; no individual-email PDFs.' \
    'PST files larger than 250 MB (250,000,000 bytes) are skipped and recorded.' \
    'EML/MSG: groups of up to 20 messages, then standalone PDFs for the same type.' \
    'Completed PDFs appear after security verification; conformance results follow.' \
    'Prints failed/incomplete files and diagnostics; removes temporary run evidence on exit.' \
    'Uses concurrent Java processes, limited automatically by available CPU and memory.' \
    'Example: eapdf-regenerate-experimental everything --workers 4 --jobs 2' \
    'Default creator: Thinkbox.DIGITAL (no creator argument required).' \
    'Preview: eapdf-regenerate-experimental everything --dry-run' \
    'Help: eapdf-regenerate-experimental --help'
  exit 0
fi
exec python3 -B "$project/scripts/regenerate_out.py" "$@"
